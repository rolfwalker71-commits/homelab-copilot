# Homelab Operations Copilot — local env template
# Copy to `.env` and fill in values. Do not commit secrets.

TAG=latest

# Proxmox API host (management IP of a cluster node, e.g. 192.168.5.101)
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=copilot
PROXMOX_TOKEN_SECRET=
# PROXMOX_PASSWORD=
PROXMOX_VERIFY_SSL=false
# Token needs PVEAuditor (VM.Audit+Sys.Audit) on path / — privilege-separated tokens do not inherit root rights.

DISCOVERY_INTERVAL_SECONDS=300
# HTTP(S)/TLS health checks + disk alerts (in-process, Europe/Berlin)
HEALTH_POLL_INTERVAL_SECONDS=300
# false = SSH-Docker auf LXCs (Produktion / Default). true nur mit docker.sock in compose.
DOCKER_USE_LOCAL_SOCKET=false
DOCKER_SSH_USER=root
# Host path of the SSH private key (compose mounts it → /data/ssh/id_ed25519:ro).
# MUST be a regular FILE before `compose up` (else Docker creates a directory → broken SSH).
# Keep named volume copilot-data:/data ONLY — never add ./data:/data (overwrites volume →
# SQLite "unable to open database file" crash-loop). Never mount the key onto /data itself.
# Prepare: mkdir -p data/ssh && install -m 600 /path/to/id_ed25519 data/ssh/id_ed25519
# Live/prod: DOCKER_SSH_KEY_HOST_PATH=/home/homelab-copilot/data/ssh/id_ed25519
DOCKER_SSH_KEY_HOST_PATH=./data/ssh/id_ed25519
# Inside container (do not change unless you also change the compose mount target):
# DOCKER_SSH_KEY_PATH=/data/ssh/id_ed25519
# Same key: Docker discovery, container start/stop/logs, browser SSH terminal.

# --- Backup Verifier (modules/backup_verifier) ---
# Destinations (order, SFTP hosts, credentials, keep-N) are configured in the UI:
#   /modules/backup_verifier/destinations
# Env values below only seed the DB on first start / provide local paths.
# Copilot host archive dir (in-container; do not change — compose bind targets this)
BACKUP_COPILOT_DIR=/data/backups
# Optional: Host-Pfad NUR für /data/backups (Hetzner Cloud Volume), ohne copilot-data
# zu ersetzen. SQLite/Keys/VAPID bleiben im Named Volume. Nie ./data:/data und nie
# das Volume über ganz /data binden.
#
# Compose-Zeile in docker-compose.yml ist auskommentiert: ein leerer Bind-Pfad
# zerlegt den Container. Erst Volume mounten, Backups kopieren, dann einkommentieren.
#
# 1) Volume als ext4, dauerhaft in fstab, z.B.:
#    /dev/disk/by-id/scsi-0HC_Volume_106797960  /mnt/HC_Volume_106797960  ext4  discard,nofail,defaults  0  0
# 2) Bestehende Backups ZUERST aus dem Named Volume kopieren — danach verdeckt
#    der Bind /data/backups im Volume (unsichtbar, nicht gelöscht):
#    VOL=$(docker volume ls -q | grep '_copilot-data$')
#    docker run --rm -v "$VOL:/from" -v /mnt/HC_Volume_106797960:/to alpine \
#      sh -c 'mkdir -p /to && cp -a /from/backups/. /to/ && chown -R 10001:10001 /to'
# 3) Pfad setzen, Bind-Zeile in docker-compose.yml einkommentieren, Container neu anlegen:
#    docker compose up -d
# BACKUP_HOST_PATH=/mnt/HC_Volume_106797960
# Ephemeral staging dir on each LXC (created via SSH; purged after first durable hop)
BACKUP_LXC_DIR=/var/backups/homelab-copilot
# Seed keep counts (overridable per destination in the UI)
BACKUP_LXC_KEEP=2
BACKUP_COPILOT_KEEP=5
BACKUP_SYNOLOGY_KEEP=10
# Optional seed for one SFTP destination (Synology / Storage Box) — prefer UI after first start
BACKUP_SYNOLOGY_HOST=
BACKUP_SYNOLOGY_USER=
BACKUP_SYNOLOGY_PATH=
# Optional; empty reuses DOCKER_SSH_KEY / /data/ssh/id_ed25519
BACKUP_SYNOLOGY_KEY_PATH=
BACKUP_SYNOLOGY_PORT=22
BACKUP_QUIESCE=true
# Short SSH (compose stop/start, restic-Probe). NICHT für apt-get / tar / SCP.
# BACKUP_SSH_TIMEOUT=120
# Wall-clock for remote tar / restic backup / extract (nohup+poll)
# BACKUP_ARCHIVE_TIMEOUT=3600
# SCP / SFTP hops (LXC ↔ Copilot ↔ Synology), inkl. restic-Binary-Kopie
# BACKUP_TRANSFER_TIMEOUT=3600
# Legacy only. Backup schedules run in-process; host crontab curl is unused.
# BACKUP_API_BASE=http://127.0.0.1:6655
# If restic is missing on the LXC: copy Copilot image binary, else apt/apk (nohup+poll)
# RESTIC_INSTALL=true
# Wall-clock for apt/apk restic bootstrap only (default 600s; not BACKUP_SSH_TIMEOUT)
# RESTIC_INSTALL_TIMEOUT=600
# If rsync is missing on the LXC: apt/apk (nohup+poll), then rsync-over-SSH; SFTP last
# BACKUP_RSYNC_INSTALL=true
# Wall-clock for apt/apk rsync bootstrap only (default 600s; same as RESTIC_INSTALL_TIMEOUT)
# BACKUP_RSYNC_INSTALL_TIMEOUT=600
# Copilot→Hetzner Storage Box (restic dest hop): rsync over SSH when possible.
# In Hetzner Robot „SSH-Unterstützung“ aktivieren. Port 23 = SSH/rsync/Borg;
# Port 22 = nur SFTP (Fallback, wenn SSH-23 fehlt oder der Key abgelehnt wird).
# Dest-Host/Port/Auth stehen in der Ziele-UI, nicht in diesen Env-Vars.
# Nightly restore-drill (Europe/Berlin). Default 05:00 — after patcher 04:00 / typical backup windows.
# restic check locally; dest = SFTP stat of repo `config` only (no Hetzner pack download).
# Push only on failure (and first success after failure), via backup_failure pref.
BACKUP_DRILL_ENABLED=true
BACKUP_DRILL_HOUR=5
BACKUP_DRILL_DEST=true
# BACKUP_DRILL_TIMEOUT=600

# --- Patch-Management (modules/patcher) ---
# Optional LLM summary (OpenAI-compatible; Ollama e.g. http://127.0.0.1:11434/v1).
# Docker: vars must be in compose `environment:` (already wired) — `compose up -d`
# recreates the container after changing these. Local uvicorn: pydantic reads `.env`.
# UI shows "Kein LLM-Key" when PATCHER_LLM_API_KEY is empty inside the process.
PATCHER_LLM_API_KEY=
PATCHER_LLM_BASE_URL=https://api.openai.com/v1
# OpenAI examples: gpt-4o-mini, gpt-4.1-mini (not gpt-41-mini)
PATCHER_LLM_MODEL=gpt-4o-mini
# PATCHER_LLM_TIMEOUT=60
# Per-host SSH command budget (detect/list). Scan-all does not share this.
# PATCHER_SCAN_TIMEOUT=180
# PATCHER_CONNECT_TIMEOUT=15
# PATCHER_APPLY_TIMEOUT=3600
# Per-hop do-release-upgrade (24.10→26.04 = 3 hops, 30–90+ min each). Never auto-run.
# PATCHER_RELEASE_TIMEOUT=10800
# Time-boxed apt-get update / dnf / apk index refresh; scan falls back to cache.
# PATCHER_INDEX_TIMEOUT=45
# PATCHER_API_BASE=http://127.0.0.1:6655
# In-process daily scan of all hosts (Europe/Berlin). Works inside Docker.
# Same loop also checks Docker image updates (badges on host cards).
PATCHER_DAILY_ENABLED=true
PATCHER_DAILY_HOUR=4
# Auto-snapshots before apply / release-upgrade. Keep last N `hlops-*` snaps (1–50).
PATCHER_SNAP_KEEP=3
# Optional 5-field cron override (minute hour * * *), e.g. 0 4 * * *
# PATCHER_CRON=

# --- TOTP site gate (secret stored in DATA_DIR/app.db, not in git) ---
TOTP_COOKIE_DAYS=30
TOTP_ISSUER=HomelabOps
# auto | true | false — Secure cookie (auto = HTTPS / X-Forwarded-Proto)
# TOTP_COOKIE_SECURE=auto

# --- Web Push (optional env override; else generated into DATA_DIR/app.db on first start) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@localhost
